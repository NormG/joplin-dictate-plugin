{
  "name": "joplin-plugin-dictate",
  "version": "1.0.3",
  "description": "Record voice, transcribe locally with Whisper, and create Joplin notes or to-dos",
  "author": "Norm Green",
  "homepage": "https://github.com/NormG/joplin-dictate-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NormG/joplin-dictate-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/NormG/joplin-dictate-plugin/issues"
  },
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "test": "npx vitest run",
    "prepare": "npm run dist",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
    "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force"
  },
  "license": "MIT",
  "keywords": [
    "joplin-plugin",
    "dictate",
    "voice",
    "whisper",
    "transcription",
    "speech",
    "todo"
  ],
  "files": [
    "publish"
  ],
  "devDependencies": {
    "@types/node": "^18.19.130",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "fs-extra": "^10.1.0",
    "glob": "^13.0.6",
    "tar": "^7.5.22",
    "ts-loader": "^9.3.1",
    "typescript": "^4.9.5",
    "vitest": "^4.1.10",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
